<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cpp_control</name>
  <version>0.0.1</version>
  <description>C++ control package for robot locomotion</description>
  <maintainer email="junchao@example.com">junchao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>vision_encoders</depend>  <!-- ImageTokens (adapt-sonic); build-orders after the msg pkg -->

  <!-- Optional backends: CMake requires at least one of unitree_hg / messages
       at configure time and drops the other. Declared rather than commented so
       colcon orders them ahead of this package AND puts their install prefixes
       on the search path. Without that, a build selecting only cpp_control
       cannot see unitree_hg and the FATAL_ERROR in CMakeLists fires. A declared
       package that is absent from the workspace is simply skipped, exactly as
       vision_encoders is. `messages` stays commented: it lives in the DRCL
       deploy workspace, not this one. -->
  <depend>unitree_hg</depend>
  <depend>unitree_go</depend>
  <!-- <depend>messages</depend> -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
