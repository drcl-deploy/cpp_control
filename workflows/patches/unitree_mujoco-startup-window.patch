-    usleep(500000);
+    usleep(1000);
   }
 
-  unitree::robot::ChannelFactory::Instance()->Init(param::config.domain_id, param::config.interface);
+  // LOCAL PATCH (cpp_control): moved to main(), before the physics thread is
